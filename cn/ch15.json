{"version":3,"kind":"Notebook","sha256":"e8bd9a00da5099c6a3cc63364e10e240cbee5b5b2c1998809c6c432c7cd75d1c","slug":"ch15","location":"/ch15.ipynb","dependencies":[],"frontmatter":{"title":"效率与局限性","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"Python 3","language":"python"},"authors":[{"nameParsed":{"literal":"Joseph P. Near","given":"Joseph P.","family":"Near"},"name":"Joseph P. Near","id":"contributors-myst-generated-uid-0"},{"nameParsed":{"literal":"Chiké Abuah","given":"Chiké","family":"Abuah"},"name":"Chiké Abuah","id":"contributors-myst-generated-uid-1"}],"license":{"content":{"id":"CC-BY-NC-SA-4.0","url":"https://creativecommons.org/licenses/by-nc-sa/4.0/","name":"Creative Commons Attribution Non Commercial Share Alike 4.0 International","CC":true},"code":{"id":"MIT","url":"https://opensource.org/licenses/MIT","name":"MIT License","free":true,"osi":true}},"github":"https://github.com/uvm-plaid/programming-dp","copyright":"© 2025 Joseph P. Near and Chiké Abuah","source_url":"https://github.com/uvm-plaid/programming-dp/blob/main/zh_cn/notebooks/ch15.ipynb","edit_url":"https://github.com/uvm-plaid/programming-dp/edit/main/zh_cn/notebooks/ch15.ipynb","exports":[{"format":"ipynb","filename":"ch15.ipynb","url":"/cn/build/ch15-8a07379eec41e5cbd448894cc26512c2.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"admonition","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"学习目标","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"I1xohXuwPC"}],"key":"QCFM74F8hJ"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"阅读本章后，您将能够：","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"I1p7fnFyqS"}],"key":"x9D0rRkFOU"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"设计实验，测量差分隐私算法的时间和空间开销","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Gl2ekI1S3R"}],"key":"MJpenOEHlF"}],"key":"bCwR7Ck23C"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"权衡空间效率与时间效率","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"DxPUCX7XoX"}],"key":"kqqRDFumFk"}],"key":"uR5ooBgKqC"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"考虑可用于优化的技术","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"H8pfQW0bDO"}],"key":"kqeo4Qis9c"}],"key":"o2QGjcPGja"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"描述差分隐私算法的效率瓶颈","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"w8sPvz2zTM"}],"key":"JEao1dLCpw"}],"key":"S8Qtk6uvyB"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"描述差分隐私的局限性","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"PwCn8bQ8w4"}],"key":"U4yixgByen"}],"key":"u6DgEQ305A"}],"key":"hdBrtgaFR8"}],"key":"hhNJ1FaZFl"}],"key":"sgIyA7sGqO"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"%matplotlib inline\nfrom mplfonts import use_font\nuse_font('SimHei')\nimport matplotlib.pyplot as plt\nplt.style.use('fivethirtyeight')\nimport pandas as pd\nimport numpy as np\nfrom collections import defaultdict\n\n# 一些有用的工具函数\n\ndef laplace_mech(v, sensitivity, epsilon):\n    return v + np.random.laplace(loc=0, scale=sensitivity / epsilon)\n\ndef gaussian_mech(v, sensitivity, epsilon, delta):\n    return v + np.random.normal(loc=0, scale=sensitivity * np.sqrt(2*np.log(1.25/delta)) / epsilon)\n\ndef gaussian_mech_vec(v, sensitivity, epsilon, delta):\n    return v + np.random.normal(loc=0, scale=sensitivity * np.sqrt(2*np.log(1.25/delta)) / epsilon, size=len(v))\n\ndef pct_error(orig, priv):\n    return np.abs(orig - priv)/orig * 100.0\n\ndef z_clip(xs, b):\n    return [min(x, b) for x in xs]\n\ndef g_clip(v):\n    n = np.linalg.norm(v, ord=2)\n    if n > 1:\n        return v / n\n    else:\n        return v\n    \nX = np.load('adult_processed_x.npy')\ny = np.load('adult_processed_y.npy')\n\ntraining_size = int(X.shape[0] * 0.8)\n\nX_train = X[:training_size]\nX_test = X[training_size:]\n\ny_train = y[:training_size]\ny_test = y[training_size:]\n\ny_test.shape\n\ndef predict(xi, theta, bias=0):\n    label = np.sign(xi @ theta + bias)\n    return label\n\n# 损失函数用于衡量我们的模型有多好。训练目标是最小化损失值。\n# 这是对率损失函数。\ndef loss(theta, xi, yi):\n    exponent = - yi * (xi.dot(theta))\n    return np.log(1 + np.exp(exponent))\n\n# 这是对率损失函数的梯度\n# 梯度是一个表示各个方向损失变化率的向量\ndef gradient(theta, xi, yi):\n    exponent = yi * (xi.dot(theta))\n    return - (yi*xi) / (1+np.exp(exponent))\n\ndef accuracy(theta):\n    return np.sum(predict(X_test, theta) == y_test)/X_test.shape[0]\n\ndef avg_grad(theta, X, y):\n    grads = [gradient(theta, xi, yi) for xi, yi in zip(X, y)]\n    return np.mean(grads, axis=0)\n\ndef gradient_descent(iterations):\n    # 我们用\"猜测\"的一个模型参数（权重全为0的模型）作为起始点\n    theta = np.zeros(X_train.shape[1])\n\n    # 应用训练集执行`iterations`步梯度下降\n    for i in range(iterations):\n        theta = theta - avg_grad(theta, X_train, y_train)\n\n    return theta\n\ndef L2_clip(v, b):\n    norm = np.linalg.norm(v, ord=2)\n    \n    if norm > b:\n        return b * (v / norm)\n    else:\n        return v\n    \ndef gradient_sum(theta, X, y, b):\n    gradients = [gradient(theta, x_i, y_i) for x_i, y_i in zip(X,y)]\n        \n    # 求和问询\n    # L2敏感度为b（由梯度的敏感度决定）\n    return np.sum(gradients, axis=0)\n\ndef noisy_gradient_descent(iterations, epsilon, delta):\n    theta = np.zeros(X_train.shape[1])\n    sensitivity = 5.0\n    \n    noisy_count = laplace_mech(X_train.shape[0], 1, epsilon)\n    clipped_X = [L2_clip(x_i, sensitivity) for x_i in X_train]\n\n    for i in range(iterations):\n        grad_sum        = gradient_sum(theta, clipped_X, y_train, sensitivity)\n        noisy_grad_sum  = gaussian_mech_vec(grad_sum, sensitivity, epsilon, delta)\n        noisy_avg_grad  = noisy_grad_sum / noisy_count\n        theta           = theta - noisy_avg_grad\n\n    return theta","visibility":"show","key":"PoWSW0Ikoc"},{"type":"outputs","id":"PnL0UqEprPQ4psMsJJ7n3","children":[],"visibility":"show","key":"efnHiwsZAR"}],"visibility":"remove","key":"ravB8rtRZ1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"差分隐私的时间效率","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ejTnkfRY5t"}],"identifier":"id","label":"差分隐私的时间效率","html_id":"id","implicit":true,"key":"SKpwfb7p9h"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"如果差分隐私是通过直接遍历敏感实体的循环来实现的，那么生成随机数所带来的额外负担会产生显著的时间开销。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"A20mOM70Yv"}],"key":"uX9adnc8IH"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"我们可以对比两个版本计数问询的运行时间性能：一个满足差分隐私，另一个不满足差分隐私。","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xbuNlgVwhb"}],"key":"vol1LcrIL6"}],"key":"fs73o3qtZ2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import itertools\nimport operator\nimport time\n\ndef time_count(k):   \n    l = [1] * k\n    start = time.perf_counter()\n    _ = list(itertools.accumulate(l, func=operator.add))\n    stop = time.perf_counter()\n    return stop - start \n\ndef time_priv_count(k):  \n    l = [1] * k\n    start = time.perf_counter()\n    _ = list(itertools.accumulate(l, func=lambda x, y: x + laplace_mech(y,1,0.1), initial=0))\n    stop = time.perf_counter()\n    return stop - start ","key":"WmKhsg4NpF"},{"type":"outputs","id":"WGKee5K0OOgGCEIEIpLtk","children":[],"key":"Js5mqpA7kv"}],"key":"oSleg8utpk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x_axis = [k for k in range(100_000,1_000_000,100_000)]\nplt.xlabel('规模（N）')\nplt.ylabel('时间（秒）')\nplt.plot(x_axis, [time_count(k) for k in range(100_000,1_000_000,100_000)], label='普通计数')\nplt.plot(x_axis, [time_priv_count(k) for k in range(100_000,1_000_000,100_000)], label='差分隐私计数')\nplt.legend();","key":"fnou47Tv3F"},{"type":"outputs","id":"A3bvNF_o6M8GzMD_SnHE-","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"06cf07122c7ebb9cbec21ff70655e032","path":"/cn/build/06cf07122c7ebb9cbec21ff70655e032.png"}}},"key":"w4akevUrZI"}],"key":"KIQwJLiTz1"}],"key":"s8wkxpNPAc"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"图中","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nQvkiWLa4T"},{"type":"inlineMath","value":"y","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>y</mi></mrow><annotation encoding=\"application/x-tex\">y</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">y</span></span></span></span>","key":"u26IOEa8JQ"},{"type":"text","value":"轴表示计数所花费的时间，","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"L47MnjcV2v"},{"type":"inlineMath","value":"x","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>x</mi></mrow><annotation encoding=\"application/x-tex\">x</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.4306em;\"></span><span class=\"mord mathnormal\">x</span></span></span></span>","key":"pBlr8fb1qH"},{"type":"text","value":"轴表示列表大小。可以看出，对于这一特定操作，差分隐私的时间复杂度基本上与输入规模呈线性关系。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yWE98nhb9N"}],"key":"LhH5RDOKyb"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"好消息是，上述差分隐私计数的实现方法相当朴素。我们可以使用向量化等优化技术得到更好的实现！","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IcpgkkIhdE"}],"key":"Oxpc6ki1tq"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"例如，在","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"G2K00f6y1N"},{"type":"link","url":"/ch12","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"前面","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"pEol9CfBlX"}],"urlSource":"ch12.ipynb","dataUrl":"/ch12.json","internal":true,"protocol":"file","key":"ghL6r1T0y8"},{"type":"text","value":"章节中为机器学习操作实现差分隐私时，我们使用了针对向量运算进行过深度优化的NumPy函数。在这一场景下，利用这种策略，使用差分隐私所带来的时间开销几乎可以忽略不计。","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"dQVO8hnauD"}],"key":"PD9t4oZmHO"}],"key":"GPQuasMkeP"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"delta = 1e-5\n\ndef time_gd(k):   \n    start = time.perf_counter()\n    gradient_descent(k)\n    stop = time.perf_counter()\n    return stop - start \n\ndef time_priv_gd(k):   \n    start = time.perf_counter()\n    noisy_gradient_descent(k, 0.1, delta)\n    stop = time.perf_counter()\n    return stop - start ","key":"pFRYAyMSjL"},{"type":"outputs","id":"TDMYMlapBlaTq4m0dgZAf","children":[],"key":"sFKQW941mx"}],"key":"ChWlfNI1t1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x_axis = [k for k in range(10,100,25)]\nplt.xlabel('规模（N）')\nplt.ylabel('时间（秒）')\nplt.plot(x_axis, [time_gd(k) for k in range(10,100,25)], label='普通梯度下降')\nplt.plot(x_axis, [time_priv_gd(k) for k in range(10,100,25)], label='差分隐私梯度下降')\nplt.legend();","key":"xfamWypBii"},{"type":"outputs","id":"jKW5fkxevvGhBv97jL-8r","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"ff30e1beb86947185fe65cec386805a0","path":"/cn/build/ff30e1beb86947185fe65cec386805a0.png"}}},"key":"BQ5LMrhZD0"}],"key":"aYqSsBUn2O"}],"key":"NFP3lDilhL"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"在这一实验的大多数模拟结果中，两条曲线基本重合或非常接近，这表明使用差分隐私梯度下降所带来的时间开销很低（为常数）。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yAYcVarxZy"}],"key":"xBmKYN5lsU"}],"key":"QuUA0x7j50"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"差分隐私下模型训练所需迭代次数的增加","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wQTbpEJDx8"}],"identifier":"id","label":"差分隐私下模型训练所需迭代次数的增加","html_id":"id-1","implicit":true,"key":"oYcw3eQPpk"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"为了满足差分隐私而在模型训练中引入噪声时，往往需要更多的迭代次数（如更多的训练步数或训练轮数），模型才能收敛到可接受的性能水平。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RNXPYl5VwO"}],"key":"voCDDvlos5"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"训练时间的增加主要源于噪声对学习过程的干扰。DP-SGD（差分隐私随机梯度下降，Differentially Private Stochastic Gradient Descent）等差分隐私机制在优化过程中为梯度添加噪声。这些梯度是根据小批量数据计算得到的，添加噪声的目的是掩盖任意单个数据点的影响。虽然这种方法可以有效地保护隐私，但其副作用是让梯度的噪声更大、包含的信息更少。优化器接收到的、关于损失函数曲面中真实移动方向的信号更弱，这可能会减慢学习速度。","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"JcxIiD9FvV"}],"key":"POPCPEO8Rc"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"为了应对噪声带来的不稳定性，从业者通常会使用更小的学习率。更小的步长有助于避免模型出现异常行为，但也会导致收敛速度变慢。梯度的可靠性降低，更新步骤也更加谨慎，两者叠加意味着模型通常需要更长的时间才能得到有用的解。在很多情况下，这意味着需要训练更多轮数、评估更多检查点，并可能需要使用容忍度更宽松的早停策略。","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"iymZpapEx4"}],"key":"UMQPDKR801"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"在实际应用中，这意味着在差分隐私下训练模型不仅需要更多的迭代次数，还需要更仔细地调整学习率、批量大小、裁剪范数和噪声乘数等超参数。例如，本书前面对比了满足和不满足差分隐私的逻辑回归模型训练过程，并观察到满足差分隐私的模型收敛得更慢，能达到的最高准确率也更低。这与文献中的观察结果一致：差分隐私让学习变得更加困难，但只要采用正确的策略并投入足够的计算资源，仍然可以训练出有用的模型。","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"O4gQ37krLY"}],"key":"mbLNTpv83x"}],"key":"GD7hjS9Jug"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"差分隐私的空间开销","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nGpsT2F2Md"}],"identifier":"id","label":"差分隐私的空间开销","html_id":"id-2","implicit":true,"key":"zlh13jAS1W"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"我们也可以分析差分隐私机制的空间使用情况。Python3（3.4）引入了一个","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"euqrAGTRp9"},{"type":"link","url":"https://docs.python.org/3/library/tracemalloc.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"调试工具","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PSnSQCoz2Z"}],"urlSource":"https://docs.python.org/3/library/tracemalloc.html","key":"z4aOPDdgav"},{"type":"text","value":"，可以追踪程序执行期间分配的内存块。我们可以比较差分隐私计算和非差分隐私计算所使用内存块的峰值大小，以此分析空间开销。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BP7g2Fs7ri"}],"key":"gz7zXtIZFT"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"利用这一策略，我们可以按照下述方法分析差分隐私计数操作的空间开销：","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tjcmTCfKQs"}],"key":"CVCQFStL5u"}],"key":"VhsoE6apa9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import itertools\nimport operator\nimport tracemalloc\n\ndef space_count(k):   \n    l = [1] * k\n    itertools.accumulate(l, func=operator.add)\n    _, peak = tracemalloc.get_traced_memory()\n    tracemalloc.reset_peak()\n    return peak/1000 \n\ndef space_priv_count(k):  \n    l = [1] * k\n    itertools.accumulate(l, func=lambda x, y: x + laplace_mech(y,1,0.1), initial=0)\n    _, peak = tracemalloc.get_traced_memory()\n    tracemalloc.reset_peak()\n    return peak/1000","key":"t5mnC9jN7q"},{"type":"outputs","id":"zITEcS13g0l83GIkg3uom","children":[],"key":"lESkRncGDn"}],"key":"L8Dhpj97iA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tracemalloc.start()\nx_axis = [k for k in range(100_000,1_000_000,100_000)]\nplt.xlabel('规模（N）')\nplt.ylabel('内存块')\nplt.plot(x_axis, [space_count(k) for k in range(100_000,1_000_000,100_000)], label='普通计数')\nplt.plot(x_axis, [space_priv_count(k) for k in range(100_000,1_000_000,100_000)], label='差分隐私计数')\ntracemalloc.stop()\nplt.legend();","key":"VChx346oLf"},{"type":"outputs","id":"V1qYfRUfNhllv1Pjg3bmr","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1edb68161b286000140d913396c2c4c6","path":"/cn/build/1edb68161b286000140d913396c2c4c6.png"}}},"key":"S21qr3oqFU"}],"key":"fdDs4gpRRm"}],"key":"nTr7b1He1J"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"图中","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YRVJqeHGzW"},{"type":"inlineMath","value":"y","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>y</mi></mrow><annotation encoding=\"application/x-tex\">y</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.625em;vertical-align:-0.1944em;\"></span><spa