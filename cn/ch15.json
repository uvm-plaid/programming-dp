n    tracemalloc.reset_peak()\n    return peak/1_000_000 \n\ndef space_priv_gd(k):   \n    noisy_gradient_descent(k, 0.1, delta)\n    _, peak = tracemalloc.get_traced_memory()\n    tracemalloc.reset_peak()\n    return peak/1_000_000","key":"QcHiPIzvDe"},{"type":"outputs","id":"cQkQjHBXKQy5ippqbfh1j","children":[],"key":"vrQoSbSNCd"}],"key":"NYtjoakoke"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"tracemalloc.start()\nx_axis = [k for k in range(5,10,2)]\nplt.xlabel('规模（N）')\nplt.ylabel('内存块')\nplt.plot(x_axis, [space_gd(k) for k in range(5,10,2)], label='普通梯度下降')\nplt.plot(x_axis, [space_priv_gd(k) for k in range(5,10,2)], label='差分隐私梯度下降')\ntracemalloc.stop()\nplt.legend();","key":"lzukbem3R9"},{"type":"outputs","id":"FbKO-QlOnr4M1rTDNLH_5","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 640x480 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"b6550acb6eeeb5dab74b2875ffdc3ef4","path":"/cn/build/b6550acb6eeeb5dab74b2875ffdc3ef4.png"}}},"key":"vxjb8r4xE4"}],"key":"QnpmZn3Ecc"}],"key":"ZQLWWQZbFC"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"在这种情况下，由于我们执行的是梯度下降，内存分配量通常要大得多（这符合预期），因此图中以百万为单位表示已分配的内存块数量。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZgMjcT1sAZ"}],"key":"KPwHdp6rwB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"我们同样观察到，差分隐私梯度下降的空间开销基本上是常数。不过，这里的空间开销要大得多，因为我们为了提高时间效率，额外使用了一些空间来实现向量化和并发。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kzCqBPuCFH"}],"key":"SFlehqpxnD"}],"key":"heRDRoRUCn"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note",